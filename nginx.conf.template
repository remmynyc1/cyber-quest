events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;

    # at most a few concurrent terminals per visitor address
    limit_conn_zone $binary_remote_addr zone=term_conn:1m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen ${PORT};

        # Internal sub-request: asks Spring Boot "is this visitor signed in?"
        # 2xx = allowed, 401/403 = denied. Spring keeps the session, so the real login is the only key.
        location = /_terminal_auth {
            internal;
            proxy_pass http://127.0.0.1:8085/api/quest/terminal-auth;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # 1. Web application
        location / {
            proxy_pass http://127.0.0.1:8085;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port 443;
            proxy_redirect http://127.0.0.1:8085/ /;
            proxy_redirect default;
        }

        # 2. Terminal: ONLY for signed-in users
        location /terminal/ {
            auth_request /_terminal_auth;
            limit_conn term_conn 4;

            proxy_pass http://127.0.0.1:7681;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 1800s;
            proxy_send_timeout 1800s;
        }
    }
}
